{
  "name": "balderdash",
  "version": "0.1.0",
  "description": "Multiplayer companion for an in-person dictionary bluffing game",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "node dev-server/server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "words:import": "node tools/words/import.mjs",
    "words:validate": "node tools/words/validate.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "private": true
}
