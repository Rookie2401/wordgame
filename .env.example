# Copy to .env.local for local work against a real Supabase project.
# Both values are public by design; the service-role key must never appear in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Or, to use the local in-process backend instead (npm run dev:backend):
# VITE_LOCAL_BACKEND_URL=http://127.0.0.1:5197
